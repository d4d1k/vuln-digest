# Optional, but recommended to raise NVD rate limits.
NVD_API_KEY=

# Leave empty to use the deterministic factual report instead of an LLM.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Create a bot through @BotFather and get the chat ID with getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

DIGEST_TOP_N=10
DIGEST_LOOKBACK_HOURS=24
DIGEST_INTERVAL_HOURS=24
DIGEST_DB_PATH=data/state.sqlite3
